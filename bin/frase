#!/usr/bin/env python3
"""frase — frase del día en gris Carbon (idea #18 de "Mi terminal").

  frase                  la frase de hoy (la misma todo el día; sale al abrir kitty)
  frase otra             una al azar
  frase <tema>           al azar de un tema: codigo, motiva, mcu, spidey, manga, rick, barca, musica, magia
  frase + "texto — autor"  agrega una tuya (tema "mias")
  frase temas            cuántas hay de cada tema
"""
import datetime, os, random, shutil, sys, textwrap

ARCHIVO = os.path.expanduser("~/.local/share/frases/frases.txt")
ICONOS = {"codigo": "󰅩", "motiva": "󰈸", "mcu": "󰓥", "spidey": "󰓥", "manga": "󰂺", "rick": "󰚩",
          "barca": "󰒸", "musica": "󰝚", "magia": "󰘸", "mias": "󰆉"}


def gris(v, negrita=False, italica=False):
    v = max(40, min(253, int(v)))
    return f"\x1b[{'1;' if negrita else ''}{'3;' if italica else ''}38;2;{v};{v};{v + 2}m"


def carga():
    frases = []
    try:
        with open(ARCHIVO, encoding="utf-8") as f:
            for l in f:
                l = l.strip()
                if not l or l.startswith("#"):
                    continue
                partes = [p.strip() for p in l.split("|")]
                if len(partes) == 3:
                    frases.append(tuple(partes))
    except FileNotFoundError:
        pass
    return frases


def muestra(f):
    tema, texto, quien = f
    ancho = min(72, shutil.get_terminal_size((80, 24)).columns - 8)
    lineas = textwrap.wrap(texto, ancho)
    ico = ICONOS.get(tema, "󰆉")
    print(f"  {gris(90)}{ico}  {gris(225, italica=True)}{lineas[0]}\x1b[0m")
    for l in lineas[1:]:
        print(f"     {gris(225, italica=True)}{l}\x1b[0m")
    print(f"     {gris(120)}— {quien}\x1b[0m")


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "ayuda"):
        print(__doc__.strip()); return 0
    if args and args[0] == "+":
        txt = " ".join(args[1:]).strip()
        if not txt:
            print('Uso: frase + "tu frase — autor"'); return 1
        texto, _, quien = txt.partition("—")
        if not quien:
            texto, _, quien = txt.partition(" - ")
        texto, quien = texto.strip().replace("|", "/"), (quien.strip() or "ZeroFuann").replace("|", "/")
        with open(ARCHIVO, "a", encoding="utf-8") as f:
            f.write(f"mias|{texto}|{quien}\n")
        print(gris(200) + "Guardada:" + "\x1b[0m"); muestra(("mias", texto, quien)); return 0
    frases = carga()
    if not frases:
        print(f"No encontré frases en {ARCHIVO}"); return 1
    if args and args[0] == "temas":
        cuenta = {}
        for t, _, _ in frases:
            cuenta[t] = cuenta.get(t, 0) + 1
        for t, n in sorted(cuenta.items(), key=lambda x: -x[1]):
            print(f"  {gris(90)}{ICONOS.get(t, '󰆉')}  {gris(220)}{t:<8}{gris(120)} {n}\x1b[0m")
        return 0
    if args and args[0] == "otra":
        muestra(random.choice(frases)); return 0
    if args:
        del_tema = [f for f in frases if f[0] == args[0].lower().replace("ç", "c").replace("ú", "u")]
        if not del_tema:
            print(f"No hay frases de «{args[0]}». Prueba: frase temas"); return 1
        muestra(random.choice(del_tema)); return 0
    # la del día: misma todo el día, orden revuelto distinto cada año
    hoy = datetime.date.today()
    orden = list(range(len(frases)))
    random.Random(hoy.year).shuffle(orden)
    muestra(frases[orden[hoy.timetuple().tm_yday % len(frases)]])
    return 0


if __name__ == "__main__":
    sys.exit(main())
